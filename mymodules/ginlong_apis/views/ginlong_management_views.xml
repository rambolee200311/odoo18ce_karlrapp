<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ginlong_api_log_list" model="ir.ui.view">
        <field name="name">world.depot.api.log.ginlong.list</field>
        <field name="model">world.depot.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="request_time"/>
                <field name="request_path"/>
                <field name="source_record"/>
                <field name="status"/>
                <field name="code"/>
                <field name="msg"/>
            </list>
        </field>
    </record>

    <record id="view_ginlong_api_log_form" model="ir.ui.view">
        <field name="name">world.depot.api.log.ginlong.form</field>
        <field name="model">world.depot.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_source_record" type="object" string="打开来源单据"
                            class="oe_highlight" invisible="not source_record"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_time"/>
                            <field name="request_path"/>
                            <field name="source_record"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="code"/>
                            <field name="msg"/>
                            <field name="request_source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="请求">
                            <field name="request_data" nolabel="1"/>
                        </page>
                        <page string="响应">
                            <field name="response_data" nolabel="1"/>
                            <field name="exception_details"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ginlong_api_logs" model="ir.actions.act_window">
        <field name="name">Ginlong API 日志</field>
        <field name="res_model">world.depot.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ginlong_api_log_list"/>
        <field name="domain">['|', ('request_path', 'ilike', '/api/ginlong/'), ('request_path', 'ilike', 'TPL_')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="action_ginlong_settings" model="ir.actions.act_window">
        <field name="name">Ginlong API 设置</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ginlong_apis'}</field>
    </record>

    <record id="action_ginlong_inbound_orders" model="ir.actions.act_window">
        <field name="name">Ginlong 入库单</field>
        <field name="res_model">world.depot.inbound.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ginlong_owner_code', '!=', False)]</field>
    </record>

    <record id="action_ginlong_outbound_orders" model="ir.actions.act_window">
        <field name="name">Ginlong 出库单</field>
        <field name="res_model">world.depot.outbound.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ginlong_owner_code', '!=', False)]</field>
    </record>

    <record id="action_ginlong_stocktake_orders" model="ir.actions.act_window">
        <field name="name">Ginlong 盘点单</field>
        <field name="res_model">world.depot.stocktake.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <record id="action_ginlong_products" model="ir.actions.act_window">
        <field name="name">Ginlong 产品</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ginlong_owner_code', '!=', False)]</field>
    </record>

    <menuitem id="menu_ginlong_root" name="Ginlong APIs"
              parent="worlddepot.world_depot_logi_menu" sequence="1200"/>
    <menuitem id="menu_ginlong_settings" name="API 设置" parent="menu_ginlong_root"
              action="action_ginlong_settings" groups="base.group_system" sequence="10"/>
    <menuitem id="menu_ginlong_logs" name="API 日志" parent="menu_ginlong_root"
              action="action_ginlong_api_logs" groups="stock.group_stock_manager" sequence="20"/>
    <menuitem id="menu_ginlong_inbound_orders" name="入库单" parent="menu_ginlong_root"
              action="action_ginlong_inbound_orders" groups="stock.group_stock_user" sequence="30"/>
    <menuitem id="menu_ginlong_outbound_orders" name="出库单" parent="menu_ginlong_root"
              action="action_ginlong_outbound_orders" groups="stock.group_stock_user" sequence="40"/>
    <menuitem id="menu_ginlong_stocktake_orders" name="盘点单" parent="menu_ginlong_root"
              action="action_ginlong_stocktake_orders" groups="stock.group_stock_user" sequence="50"/>
    <menuitem id="menu_ginlong_products" name="产品" parent="menu_ginlong_root"
              action="action_ginlong_products" groups="stock.group_stock_user" sequence="60"/>
</odoo>

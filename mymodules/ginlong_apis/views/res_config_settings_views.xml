<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 限流值和回传 Endpoint 复用系统设置；回传地址未配置时按钮发送会明确提示。 -->
    <record id="res_config_settings_view_form_ginlong_apis" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ginlong.apis</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="ginlong_apis" string="Ginlong APIs">
                    <block title="入站 API 限流（每秒请求数）" name="ginlong_api_rate_limits">
                        <setting string="API01 入库单" help="同一认证 API 用户每秒允许的 API01 请求数。">
                            <field name="ginlong_api01_rate_limit"/>
                        </setting>
                        <setting string="API03 出库单" help="同一认证 API 用户每秒允许的 API03 请求数。">
                            <field name="ginlong_api03_rate_limit"/>
                        </setting>
                        <setting string="API05 盘点单" help="同一认证 API 用户每秒允许的 API05 请求数。">
                            <field name="ginlong_api05_rate_limit"/>
                        </setting>
                        <setting string="API07 产品档案" help="同一认证 API 用户每秒允许的 API07 请求数。">
                            <field name="ginlong_api07_rate_limit"/>
                        </setting>
                        <setting string="API09 库存查询" help="同一认证 API 用户每秒允许的 API09 请求数。">
                            <field name="ginlong_api09_rate_limit"/>
                        </setting>
                    </block>
                    <block title="回传 API Endpoint（固定 POST，JSON）" name="ginlong_callback_endpoints">
                        <setting string="API02 收货确认">
                            <field name="ginlong_api02_callback_url" placeholder="完整 URL，路径：/API/WMS_JSON/TPL_Receipt_Confirmation"/>
                        </setting>
                        <setting string="API04 入库完成">
                            <field name="ginlong_api04_callback_url" placeholder="完整 URL，路径：/API/WMS_JSON/TPL_Inbound_Completion"/>
                        </setting>
                        <setting string="API06 备货完成">
                            <field name="ginlong_api06_callback_url" placeholder="完整 URL，路径：/API/WMS_JSON/TPL_Picking_Completed"/>
                        </setting>
                        <setting string="API08 发货完成">
                            <field name="ginlong_api08_callback_url" placeholder="完整 URL，路径：/API/WMS_JSON/TPL_Shipment_Completed"/>
                        </setting>
                        <setting string="API10 盘点完成">
                            <field name="ginlong_api10_callback_url" placeholder="完整 URL，路径：/API/WMS_JSON/TPL_Stocktaking_Completed"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
